    {
      "id": "D9",
      "label": "Genuinely contested decision",
      "rationale": "60/40 across 45 well-spread samples with a 93% success rate. Both branches work. This is a decision that actually requires judgment, and the honest output is silence.",
      "workflowName": "demo-workflow",
      "workflowVersion": "a1b2c3d",
      "decisionType": "request_additional_context",
      "contextKeyVersion": "v1",
      "availableOptions": ["YES", "NO"],
      "contexts": [
        "post_edit_small_diff",
