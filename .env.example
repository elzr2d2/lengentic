# Copy to .env and adjust. Never commit .env.
# Every variable here is validated at API startup — a missing or malformed value fails
# fast at boot rather than at the first request that needs it.

# ── Database ────────────────────────────────────────────────────────────────────
POSTGRES_USER=lengentic
POSTGRES_PASSWORD=lengentic
POSTGRES_DB=lengentic
POSTGRES_PORT=5432

# Consumed by Prisma. Host is `postgres` inside docker compose, `localhost` outside.
DATABASE_URL=postgresql://lengentic:lengentic@localhost:5432/lengentic?schema=public

# ── API ─────────────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# A RUNNING run with no event newer than this derives as STALE and is excluded from all
# historical aggregation (MVP_PLAN.md §39). Milliseconds.
STALE_RUN_THRESHOLD_MS=900000

# ── Dashboard ───────────────────────────────────────────────────────────────────
# Browser-visible, so it must be the host-reachable URL even when the API runs in Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
