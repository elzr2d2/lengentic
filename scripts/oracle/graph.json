{
  "$comment": "Ground truth for LenGentic MVP delivery. Nodes are deliverables, not tasks. Status is PROBED from the repository, never hand-maintained — a checkbox lies, a probe does not. Edit this file when the plan changes; never edit it to make status look better.",
  "planRef": "MVP_PLAN_V3.md",
  "$lanePolicyComment": "Path ownership for parallel dispatch. `pnpm lanes decide` reads this. Annotation is the OPT-IN to parallelism: a node without `own.allowed` and `validate` fails the eligibility gate and falls back to sequential. That is deliberate — an unannotated node has no verified write surface, and dispatching one into a worktree beside another is exactly the collision the gate exists to prevent.",
  "lanePolicy": {
    "maxConcurrency": 2,
    "minUnits": 2,
    "$sharedComment": "Files any two lanes would both have to write. A batch touching one of these is serialised regardless of how disjoint the rest of its paths are — a lockfile or a Prisma schema written by two worktrees does not merge, it corrupts.",
    "sharedWriteSurfaces": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "tsconfig.base.json",
      "eslint.config.js",
      ".dependency-cruiser.cjs",
      ".prettierrc.json",
      "docker-compose.yml",
      ".github/workflows/**",
      "platform/database/prisma/schema.prisma",
      "platform/database/prisma/migrations/**"
    ],
    "$serialiseComment": "CLAUDE.md: platform/shared/schema is the ONLY wire contract, and the SDK and the API both derive from it. A batch that edits the contract cannot also build against it in parallel — the contract is not frozen while it is being written.",
    "serialiseIfTouches": ["platform/shared/schema/**"],
    "$forbiddenComment": "Never writable from inside a development lane, whatever its allowed_paths say. `.claude/` is engineering infrastructure and a product lane has no business editing the harness that judges it; the plan documents are the contract the lane was dispatched against.",
    "alwaysForbidden": [
      ".claude/**",
      "MVP_PLAN.md",
      "MVP_PLAN_V3.md",
      "CLAUDE.md",
      "scripts/oracle/graph.json",
      "docs/superpowers/**",
      ".git/**"
    ],
    "$lanesComment": "Default write surface per lane, from MVP_PLAN_V3.md §5. These feed collision WARNINGS only. The eligibility gate requires per-node `own.allowed`, because a lane label is a category and a work packet needs a boundary.",
    "lanes": {
      "api": {
        "allowed": ["platform/api/**"]
      },
      "contract": {
        "allowed": ["platform/shared/**"]
      },
      "doc": {
        "allowed": ["docs/**", "README.md"]
      },
      "engine": {
        "allowed": ["platform/analysis-engine/**"]
      },
      "env": {
        "allowed": []
      },
      "harness": {
        "allowed": [".artifacts/**"]
      },
      "infra": {
        "allowed": ["scripts/**", "docker/**"]
      },
      "persistence": {
        "allowed": ["platform/database/**"]
      },
      "platform": {
        "allowed": ["platform/**"]
      },
      "playground": {
        "allowed": ["playground/**"]
      },
      "pure": {
        "allowed": ["platform/api/src/**"]
      },
      "sdk": {
        "allowed": ["platform/telemetry-sdk/**"]
      },
      "test": {
        "allowed": ["platform/api/test/**"]
      },
      "ui": {
        "allowed": ["platform/dashboard/**"]
      }
    }
  },
  "$sectionsComment": "Which plan sections each deliverable actually needs. `pnpm oracle packet <id>` slices exactly these out of the plan and nothing else. MVP_PLAN_V3.md is ~25k tokens; a subagent that reads the whole thing spends 25k to learn 2k. Multiply by every agent in every wave and by every retry, and the plan itself becomes the largest single line in the bill.",
