{
  "name": "@lengentic/api",
  "version": "0.0.0",
  "private": true,
  "description": "LenGentic Telemetry API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@lengentic/database": "workspace:*",
    "@lengentic/shared": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lengentic/telemetry-sdk": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.10"
  }
}
