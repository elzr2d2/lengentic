// LenGentic database schema.
//
// The telemetry domain (Run, Step) landed in Phase 2; the rich entities (Decision, ModelCall,
// ToolCall, Error) landed in Phase 4 (p4.entities). What Phase 1 proved is that the migration
// pipeline, the client generator, and connectivity all work — adding speculative tables then
// would have violated §8 and pre-committed decisions Phase 2 should own.

// Prisma 7 removed `url` from the datasource block. The connection string lives in
// prisma.config.ts for migrations, and is passed to the client through a driver adapter
// at runtime — see ../src/index.ts.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is a NestJS app and NestJS is CommonJS. Prisma 7 is ESM-first, so the format
  // has to be stated rather than inherited.
  moduleFormat = "cjs"
}

// ---------------------------------------------------------------------------
// Telemetry domain — MVP_PLAN_V3.md §11 (identifier model) and §13 (domain model).
//
// Every identifier is CLIENT-generated (§11). Not one of these models has an `@default` on
// its primary key: the SDK supplies the id, which is what makes ingestion idempotent — an
// SDK retry after a timeout re-sends the same id and upserts the same row instead of
// creating a second one. A `@default(uuid())` here would silently restore the duplicate.
//
// Ids are typed `VarChar(128)`, not `Uuid`. §11 says UUIDv7 is *preferred* for time-ordered
// indexes, not required, and the wire contract already settled the real bound:
// `IdSchema = z.string().min(1).max(128)` in platform/shared/schema/primitives.ts. A
// `@db.Uuid` column would reject ids the wire contract accepts — a 500 on a request Zod
// already declared valid. Same reasoning for `VarChar(200)` on name-shaped columns, which
// mirrors `NameSchema`. These two bounds move only with primitives.ts.
// ---------------------------------------------------------------------------

/// Stored status only. Never STALE — MVP_PLAN_V3.md §13 and docs/decisions/0005 decision 4
/// make STALE derived at read time from `lastEventAt` and STALE_RUN_THRESHOLD_MS, computed
/// server-side and never written to a row. Mirrors RUN_STATUSES in
/// platform/shared/schema/status.ts, which is also where `StepStatus = RunStatus` is
/// declared — hence one enum for both models rather than two that can drift apart.
enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Run {
  /// Client-generated (§11). No default, deliberately — see the header note.
  id String @id @db.VarChar(128)

  /// Always equal to `id` today. Kept as its own column, reserved for future fan-out: one
  /// trace will eventually span several runs, and at that point `traceId` stops being a copy
  /// of the PK. Deliberately NOT `@unique` — a unique constraint would encode "one run per
  /// trace", which is precisely the assumption fan-out has to break. §11.
  traceId String @db.VarChar(128)

  /// Nullable at the database level even though §13 calls `workflowVersion` required, and the
  /// wire contract enforces exactly that (`RunStartedPayloadSchema` requires both, non-null).
  /// The nullability is about EVENT ARRIVAL ORDER, not about the caller's obligation: §12's
  /// merge rules create an entity from whichever event lands first, and a `runCompleted`
  /// event carries no workflow fields (`RunCompletedPayloadSchema` = status + metadata).
  /// NOT NULL would make a completion-before-start batch unstorable. Null means "the start
  /// event has not landed yet" and is excluded from aggregation, the same treatment
  /// CONTEXT.md already gives a null `contextKey`.
  workflowName    String? @db.VarChar(200)
  workflowVersion String? @db.VarChar(200)

  status RunStatus @default(RUNNING)

  /// Client clock (§13). Null until a start / completion event has been merged.
  startedAt   DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  /// Server clock (§13). `receivedAt` is set once, on row creation, and never updated.
  /// `lastEventAt` advances monotonically and is the sole input to the derived STALE read.
  /// No `@default(now())` on either: merge-rules.ts takes `receivedAt` as an explicit input
  /// so it stays a pure function, and STALE arithmetic requires both values to come from the
  /// same clock as the comparison — a database default would introduce a second one.
  receivedAt  DateTime @db.Timestamptz(3)
  lastEventAt DateTime @db.Timestamptz(3)

  /// ADR 0007 carrier columns. The tie-break when two events share an identical `occurredAt`
  /// compares `eventId`, and ADR 0007 §3 requires that to hold across requests, not only
  /// within one batch ("arrival order is never consulted, for any field, at any time").
  /// `EntityMergeState.startEventId` / `.completionEventId` therefore have to survive in the
  /// row; without them a cross-request tie silently falls back to arrival order.
  startEventId      String? @db.VarChar(128)
  completionEventId String? @db.VarChar(128)

  /// jsonb (Prisma's Postgres mapping for `Json`). Nullable: `MetadataSchema` is `.nullish()`
  /// on every payload, so "no metadata" is the normal case and must not be a rejection.
  metadata Json?

  /// Per-key provenance for `completionFields` (ADR 0007 §3) — which completion event last
  /// wrote each key of `completionFields` (today exactly one key: `metadata`), not each key
  /// inside `metadata` itself. Without this column a completion merge split across two
  /// requests cannot tell which event won per key and falls back to arrival order. Mirrors
  /// EntityMergeState.completionFieldOrigins (merge-rules.ts) — a JSON map of
  /// `{ [fieldName]: { occurredAt, eventId } }`. NULL and `{}` both rehydrate to
  /// EntityMergeState's `{}`.
  completionFieldOrigins Json?

  /// Row creation, database clock. Distinct from `receivedAt`, which is the application's
  /// server clock for the first event of this run — they will differ, and only `receivedAt`
  /// is comparable with `lastEventAt`. §13 lists both.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// ADR 0014 decision 2 / §16. Folded in from the batch-level `droppedSinceLastBatch`
  /// field (`platform/shared/schema/ingest.ts`) at the persistence edge
  /// (`TelemetryRepository.incrementDroppedCount`) — a running total across every batch
  /// that ever reported one for this run, never a per-batch snapshot.
  ///
  /// NULL, not `@default(0)`, and no NOT NULL: NULL means "no batch for this run has ever
  /// reported a drop count" — an SDK built before this field existed, or one that has simply
  /// not flushed one yet. `run-summary.ts`'s `RunSummary.droppedTelemetryEventCount` refuses
  /// to manufacture that absence into a false "nothing was dropped" `0`, and a `@default(0)`
  /// here would erase the distinction one column layer before that guard could ever see it.
  droppedTelemetryEventCount Int?

  /// The default aggregation scope: all historical analysis groups by
  /// (workflowName, workflowVersion). Phase 2 framing note; group key, CONTEXT.md.
  @@index([workflowName, workflowVersion])
}

model Step {
  /// = spanId, client-generated (§11, §13). No default.
  id String @id @db.VarChar(128)

  /// Plain column. NO foreign key to Run — see the design note in
  /// .artifacts/lanes/p2.prisma-run-step-design.md §2. A step event may legitimately arrive
  /// before its run's start event, and a stub `Run` cannot be conjured because the workflow
  /// fields live only on the start payload. An FK would turn that into a rejected event.
  runId String @db.VarChar(128)

  /// Nullable, and explicitly NO foreign key constraint (§13). Steps arrive out of order; a
  /// child may reference a parent that has not landed yet, and an FK would reject it. Null
  /// means "root step" — a distinct, deliberate signal, which is why `StepStartedPayload`
  /// types it `.nullable()` rather than optional.
  parentStepId String? @db.VarChar(128)

  /// Nullable for the same arrival-order reason as Run.workflowName: these three arrive only
  /// on `StepStartedPayload`, and a `stepCompleted` event can be the first one seen.
  name      String? @db.VarChar(200)
  agentName String? @db.VarChar(200)
  type      String? @db.VarChar(200)

  status RunStatus @default(RUNNING)

  startedAt   DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  /// Server clock, set once on creation. §13 gives Step no `lastEventAt`: liveness is a Run
  /// concept, and a step's aliveness question is really "is its run stale".
  receivedAt DateTime @db.Timestamptz(3)

  /// ADR 0007 carrier columns — same justification as on Run.
  startEventId      String? @db.VarChar(128)
  completionEventId String? @db.VarChar(128)

  metadata Json?

  /// Per-key provenance for `completionFields` (ADR 0007 §3) — which completion event last
  /// wrote each key of `completionFields` (today exactly one key: `metadata`), not each key
  /// inside `metadata` itself. Without this column a completion merge split across two
  /// requests cannot tell which event won per key and falls back to arrival order. Mirrors
  /// EntityMergeState.completionFieldOrigins (merge-rules.ts) — a JSON map of
  /// `{ [fieldName]: { occurredAt, eventId } }`. NULL and `{}` both rehydrate to
  /// EntityMergeState's `{}`.
  completionFieldOrigins Json?

  @@index([runId])
  @@index([parentStepId])
}

/// The dedup ledger — ADR 0005 §1, corrected into existence by ADR 0009 (F3). "Have I seen
/// this eventId?" was previously reconstructed from Run/Step's own provenance columns
/// (startEventId, completionEventId, completionFieldOrigins), which record winners only: an
/// event that loses its merge contest leaves no trace on the row and was re-classified
/// ACCEPTED on every replay, forever. This table answers the question directly and
/// completely — every accepted event is recorded here, winners and losers alike — and is
/// deliberately thin: `eventId`, `runId`, `receivedAt`, nothing else. ADR 0005 decision 1
/// rejected a full event-payload ledger; this is not a source of truth for anything except
/// "has this event already been ingested". Raw events remain unreplayable without a Phase 5
/// migration — that cost is accepted, not paid here.
model IngestedEvent {
  /// Client-generated idempotency key (§11/§12). Unique per run, not globally — see `runId`
  /// below — so never `@id` on its own.
  eventId String @db.VarChar(128)

  /// Same run-scoping reason as every other id in this file: ADR 0005 §2 requires
  /// `(runId, eventId)`, not `eventId` alone, BECAUSE `MVP_PLAN_V3.md`'s `SeededIdGenerator`
  /// produces identical eventIds by design across different runs (Phase 3/6 determinism). A
  /// global unique key on `eventId` would misclassify a genuinely new run's replayed seeded
  /// scenario as DUPLICATE — a Phase 3 failure manufactured by a Phase 2 index.
  runId String @db.VarChar(128)

  /// Server clock, the same single reading `TelemetryService.ingest` takes once per request
  /// (`Run.receivedAt`'s neighbour, same reasoning: not `@default(now())`, so this stays a
  /// value the caller controls rather than a second clock the merge has to reconcile).
  receivedAt DateTime @db.Timestamptz(3)

  /// Composite PK doubles as the ADR 0005 §2 uniqueness constraint — one index serves both
  /// "is this a duplicate" (equality lookup) and "no two rows for the same (runId, eventId)"
  /// (the constraint itself), so no separate `@@unique` is needed.
  @@id([runId, eventId])
}

/// ADR 0014 decision 2's replay guard for `droppedSinceLastBatch`, split out of
/// `IngestedEvent` (Phase 4 phase gate repair attempt 2 — Reviewer B1/B5, Tester F1/F4).
/// Attempt 1 folded the synthetic key into `IngestedEvent.eventId` as `"drop:" + deliveryId`,
/// which broke that table's own two invariants at once: `eventId` grew a second, 5-char-
/// longer value space that could overflow the same `VarChar(128)` the wire's own `deliveryId`
/// (`IdSchema`, `max(128)`) is allowed to fill, and it put a non-event row in a table whose
/// header comment and every reader (`loadIngestedEventIds`) say "every accepted event, and
/// nothing else". This table answers a different question — "has this run already been
/// credited for this delivery?" — with its own column, sized to exactly what `deliveryId`
/// can be (no prefix, so no possible overflow), and no shared namespace with a real
/// `eventId` for a real one to collide with.
///
/// Deliberately as thin as `IngestedEvent`: `runId`, `deliveryId`, `receivedAt`, nothing
/// else. `TelemetryRepository.incrementDroppedCount` inserts a row here (skipping the
/// insert, and therefore the increment, when one already exists for this `(runId,
/// deliveryId)`) only when the batch's reported amount is non-zero — adding zero is
/// idempotent by construction and needs no replay guard, so a batch reporting no NEW drops
/// never grows this table (F5).
model DropDelivery {
  /// Same run-scoping reason as `IngestedEvent.runId`: a client-generated id is unique per
  /// run, not globally.
  runId String @db.VarChar(128)

  /// `IngestRequestSchema.deliveryId` verbatim — `IdSchema`, `max(128)` — never a derived or
  /// prefixed value, so this column's width and the wire's own bound are the same number by
  /// construction, not by a comment promising they will not drift apart.
  deliveryId String @db.VarChar(128)

  /// Server clock, same reasoning as `IngestedEvent.receivedAt`.
  receivedAt DateTime @db.Timestamptz(3)

  @@id([runId, deliveryId])
}

// ---------------------------------------------------------------------------
// Rich entities — MVP_PLAN_V3.md §13 (Decision, ModelCall, ToolCall, Error) and §14
// (contextKey, attestation). Same doctrine as Run/Step: client-generated VarChar(128) ids
// with no `@default`, VarChar(200) name-shaped columns mirroring NameSchema, no foreign
// keys anywhere — events arrive out of order, and an FK would turn a legitimate
// arrival-order permutation into a rejected event (see Step.runId).
//
// Nullability follows §13's own markers: §13 writes "nullable" or "optional" where it means
// it (Step.parentStepId, ModelCall tokens) and is otherwise stating the caller's obligation,
// which the wire contract enforces — the database stays permissive only where an event pair
// can genuinely arrive in either order. Decision is the one model where that hazard is
// broad: §14 makes attestation an independent event keyed on `decisionId`, and an
// attestation for an unknown decisionId is accepted and stored, not rejected. An
// attestation-first row therefore has an id, a runId (envelope-level, always present), the
// outcome columns — and nothing else. Every other Decision column is nullable for exactly
// that reason.
// ---------------------------------------------------------------------------

/// §13/§14 attested outcome. UNKNOWN is the pre-attestation state, not a failure.
enum DecisionOutcome {
  SUCCESS
  FAILURE
  UNKNOWN
}

/// §14: stays `CALLER | UNKNOWN`. An INFERRED value has no producer and would be
/// speculative schema. Every surface reading this says "attested success rate" — the
/// caller asserts the outcome; the Platform has no independent way to verify it.
enum OutcomeAttestedBy {
  CALLER
  UNKNOWN
}

model Decision {
  /// Client-generated (§11). Stable across processes — §14's cross-process attestation is
  /// keyed on exactly this value.
  id String @id @db.VarChar(128)

  /// Required: every telemetry envelope carries `runId` (TelemetryEventEnvelopeSchema), so
  /// even an attestation-first row has one. Plain column, no FK — see the header note.
  runId String @db.VarChar(128)

  /// Nullable for the attestation-first case in the header note, not because a recorded
  /// decision may omit it.
  stepId String? @db.VarChar(128)

  /// The recurring decision point being analyzed, e.g. `execution_strategy` (§29).
  /// Nullable: attestation-first.
  decisionType String? @db.VarChar(200)

  /// §14: caller-supplied, caller-computed (docs/decisions/0003). Null means the caller
  /// supplied none OR only the attestation has landed; either way the row is stored but
  /// EXCLUDED from aggregation — silent inclusion under a default key is how fake dominance
  /// gets manufactured.
  contextKey        String? @db.VarChar(200)
  contextKeyVersion String? @db.VarChar(200)

  /// Size-capped and redacted at ingestion (§15) — the database stores what survived.
  /// Stored alongside the key so re-normalization stays possible without losing history.
  /// Never contains hidden model chain-of-thought (§13).
  rawContext Json?

  /// JSON array of option names. selectedOption mirrors NameSchema's bound.
  availableOptions Json?
  selectedOption   String? @db.VarChar(200)

  /// §14 attestation, last write wins: re-attesting the same decisionId overwrites all
  /// three columns. Token usage stays on ModelCall — a second denominator for the same
  /// tokens is how a run's cost gets double-counted (§13).
  outcome           DecisionOutcome   @default(UNKNOWN)
  outcomeAttestedBy OutcomeAttestedBy @default(UNKNOWN)
  outcomeObservedAt DateTime?         @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId])
  @@index([stepId])
}

model ModelCall {
  id String @id @db.VarChar(128)

  /// Plain columns, no FKs. Unlike Decision there is exactly one event type behind this
  /// model, so §13's unmarked fields are simply required — no arrival-order hazard.
  runId  String @db.VarChar(128)
  stepId String @db.VarChar(128)

  provider String @db.VarChar(200)
  model    String @db.VarChar(200)

  latencyMs Int

  /// §13 marks exactly these two optional.
  inputTokens  Int?
  outputTokens Int?

  /// §13 leaves the vocabulary unenumerated; the Phase 4 wire contract owns it. Free
  /// string rather than a speculative enum — an enum invented here would reject values
  /// the wire contract later accepts.
  status String @db.VarChar(200)

  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId])
  @@index([stepId])
}

model ToolCall {
  id String @id @db.VarChar(128)

  runId  String @db.VarChar(128)
  stepId String @db.VarChar(128)

  toolName String @db.VarChar(200)

  /// Size-capped and redacted at ingestion (§15); nullable because "no input" / "no
  /// output" is a legitimate tool shape and must not be a rejection — the same treatment
  /// MetadataSchema gets everywhere else.
  input  Json?
  output Json?

  /// Whether the §15 cap truncated the stored value; the *Bytes columns record the
  /// original, pre-cap sizes so truncation loses the payload, not the measurement.
  ///
  /// Nullable (Reviewer S3, Phase 4 phase gate repair attempt 1; previously NOT NULL —
  /// migration 20260903120000_tool_call_bytes_nullable). `null` is "captureToolIO: false —
  /// nothing was measured", distinct from a real, reported `0`; before this migration the
  /// wire had nowhere to put that state and the SDK sent a manufactured `0` instead, which
  /// the Dashboard then rendered as a genuine "0 bytes lost to truncation" — `CLAUDE.md`
  /// ## Product claims. A present value's meaning is unchanged; only the absent state is new.
  inputTruncated  Boolean @default(false)
  outputTruncated Boolean @default(false)
  inputBytes      Int?
  outputBytes     Int?

  /// Client clock (§13). Required: the SDK records a tool call after it finishes, in one
  /// event — there is no start/completion pair to arrive out of order.
  startedAt   DateTime @db.Timestamptz(3)
  completedAt DateTime @db.Timestamptz(3)
  durationMs  Int

  /// `error` is null on success; §13 has no createdAt on ToolCall and none is added here.
  success Boolean
  error   String?

  @@index([runId])
  @@index([stepId])
}

model Error {
  id String @id @db.VarChar(128)

  runId  String @db.VarChar(128)
  stepId String @db.VarChar(128)

  type    String @db.VarChar(200)
  /// Unbounded text, not VarChar — an error message is captured evidence, and truncating
  /// evidence at an arbitrary column bound loses exactly the interesting cases.
  message String

  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId])
  @@index([stepId])
}
